# Nuxt frontend
NUXT_PUBLIC_DIRECTUS_URL=http://localhost:8055
NUXT_DIRECTUS_TOKEN=
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Directus / PostgreSQL — replace every sample secret before starting services
DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=replace-with-a-long-random-database-password
DIRECTUS_KEY=replace-with-a-long-random-key
DIRECTUS_SECRET=replace-with-a-long-random-secret
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
DIRECTUS_PUBLIC_URL=http://localhost:8055
DIRECTUS_CORS_ORIGIN=http://localhost:3000
